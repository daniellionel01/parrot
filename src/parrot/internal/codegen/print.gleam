//// Turns a `model.Module` into gleam source code. The output is formatted
//// with `gleam format` afterwards.

import gleam/int
import gleam/list
import gleam/string
import parrot/internal/codegen/model.{
  type Enum, type Field, type GleamType, type Module, type Param, type Query,
  GleamEnum, GleamList, GleamOption, NoRows, Rows, Scalar, SliceParam,
  ValueParam,
}
import parrot/internal/codegen/runtime

pub fn module(module: Module) -> String {
  [
    "//// Code generated by parrot. DO NOT EDIT.\n////",
    imports(module),
    string.trim(runtime.code),
    module.enums |> list.map(enum) |> string.join("\n\n"),
    module.queries |> list.map(query) |> string.join("\n\n"),
  ]
  |> string.join("\n\n")
}

fn imports(module: Module) -> String {
  let params = list.flat_map(module.queries, fn(query) { query.params })
  let uses_list =
    list.any(params, fn(param) {
      case param {
        ValueParam(type_:, ..) -> contains_list(type_)
        SliceParam(..) -> True
      }
    })
  let uses_slices = list.any(params, is_slice)

  runtime.imports
  |> append_if(uses_list, "import gleam/list")
  |> append_if(uses_slices, "import gleam/string")
  |> string.join("\n")
}

fn contains_list(type_: GleamType) -> Bool {
  case type_ {
    GleamList(_) -> True
    GleamOption(inner) -> contains_list(inner)
    Scalar(_) | GleamEnum(_) -> False
  }
}

fn append_if(
  lines: List(String),
  condition: Bool,
  line: String,
) -> List(String) {
  case condition {
    True -> list.append(lines, [line])
    False -> lines
  }
}

// === ENUMS ================================================================

fn enum(enum: Enum) -> String {
  let model.EnumNames(type_:, to_string:, decoder:) = enum.names
  let variants = [enum.first, ..enum.rest]

  ["pub type " <> type_ <> " {", ..list.map(variants, fn(v) { "  " <> v.name })]
  |> list.append([
    "}",
    "",
    "pub fn " <> decoder <> "() -> decode.Decoder(" <> type_ <> ") {",
    "  use variant <- decode.then(decode.string)",
    "  case variant {",
    ..list.map(variants, fn(v) {
      "    \"" <> v.value <> "\" -> decode.success(" <> v.name <> ")"
    })
  ])
  |> list.append([
    "    _ -> decode.failure(" <> enum.first.name <> ", \"" <> type_ <> "\")",
    "  }",
    "}",
    "",
    "pub fn " <> to_string <> "(val: " <> type_ <> ") -> String {",
    "  case val {",
    ..list.map(variants, fn(v) {
      "    " <> v.name <> " -> \"" <> v.value <> "\""
    })
  ])
  |> list.append(["  }", "}"])
  |> string.join("\n")
}

// === QUERIES ==============================================================

fn query(query: Query) -> String {
  case query.returns {
    NoRows -> function(query)
    Rows(type_:, decoder: decoder_name, fields:) ->
      row_type(type_, fields)
      <> "\n\n"
      <> function(query)
      <> "\n\n"
      <> decoder(type_, decoder_name, fields)
  }
}

fn row_type(name: String, fields: List(Field)) -> String {
  let fields =
    list.map(fields, fn(field) {
      "    " <> field.label <> ": " <> type_string(field.type_) <> ","
    })

  ["pub type " <> name <> " {", "  " <> name <> "(", ..fields]
  |> list.append(["  )", "}"])
  |> string.join("\n")
}

fn function(query: Query) -> String {
  let arguments =
    query.params
    |> list.map(fn(param) {
      let type_ = case param {
        ValueParam(type_:, ..) -> type_string(type_)
        SliceParam(item:, ..) -> "List(" <> type_string(item) <> ")"
      }
      param.label <> " " <> param.variable <> ": " <> type_
    })
    |> string.join(", ")

  let slices =
    list.filter_map(query.params, fn(param) {
      case param {
        ValueParam(..) -> Error(Nil)
        // An empty list is replaced with `NULL`, same as sqlc does for go,
        // since `in ()` is not valid sql in every database.
        SliceParam(variable:, placeholders:, ..) ->
          Ok(
            "  let "
            <> placeholders
            <> " = case "
            <> variable
            <> " {\n    [] -> \"NULL\"\n    _ -> list.map("
            <> variable
            <> ", fn(_) { \"?\" }) |> string.join(\",\")\n  }",
          )
      }
    })

  let #(returned, return_type) = case query.returns {
    Rows(type_:, decoder:, ..) -> #(
      ["sql", params(query.values), decoder <> "()"],
      "#(String, List(Param), decode.Decoder(" <> type_ <> "))",
    )
    NoRows -> #(["sql", params(query.values)], "#(String, List(Param))")
  }

  [
    "pub fn "
      <> query.function
      <> "("
      <> arguments
      <> ") -> "
      <> return_type
      <> " {",
    ..slices
  ]
  |> list.append([
    "  let sql = " <> sql(query.sql),
    "  #(" <> string.join(returned, ", ") <> ")",
    "}",
  ])
  |> string.join("\n")
}

fn is_slice(param: Param) -> Bool {
  case param {
    ValueParam(..) -> False
    SliceParam(..) -> True
  }
}

fn sql(parts: List(model.SqlPart)) -> String {
  parts
  |> list.map(fn(part) {
    case part {
      model.Text(text) ->
        "\"" <> string.replace(text, each: "\"", with: "\\\"") <> "\""
      model.Slice(placeholders) -> placeholders
    }
  })
  |> string.join(" <> ")
}

/// Without slices the params are a list literal, otherwise every param
/// becomes a list and they are flattened.
///
fn params(params: List(Param)) -> String {
  let values =
    list.try_map(params, fn(param) {
      case param {
        ValueParam(variable:, type_:, ..) -> Ok(value_to_param(variable, type_))
        SliceParam(..) -> Error(Nil)
      }
    })

  case values {
    Ok(values) -> "[" <> string.join(values, ", ") <> "]"
    Error(_) ->
      "list.flatten(["
      <> params
      |> list.map(fn(param) {
        case param {
          ValueParam(variable:, type_:, ..) ->
            "[" <> value_to_param(variable, type_) <> "]"
          SliceParam(variable:, item:, ..) ->
            "list.map(" <> variable <> ", " <> item_to_param(item) <> ")"
        }
      })
      |> string.join(", ")
      <> "])"
  }
}

/// Wraps the gleam value `variable` of type `type_` in a `Param`.
///
fn value_to_param(variable: String, type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).param <> "(" <> variable <> ")"
    GleamEnum(names) ->
      "ParamString(" <> names.to_string <> "(" <> variable <> "))"
    GleamList(item) ->
      "ParamList(list.map(" <> variable <> ", " <> item_to_param(item) <> "))"
    GleamOption(inner) ->
      "ParamNullable(option.map("
      <> variable
      <> ", fn(v) { "
      <> value_to_param("v", inner)
      <> " }))"
  }
}

/// A function turning a list item into a `Param`.
///
fn item_to_param(item: GleamType) -> String {
  case item {
    Scalar(scalar) -> runtime.scalar(scalar).param
    _ -> "fn(v) { " <> value_to_param("v", item) <> " }"
  }
}

fn decoder(type_name: String, name: String, fields: List(Field)) -> String {
  let uses =
    list.index_map(fields, fn(field, index) {
      "  use "
      <> field.variable
      <> " <- decode.field("
      <> int.to_string(index)
      <> ", "
      <> type_decoder(field.type_)
      <> ")"
    })
  let arguments =
    fields
    |> list.map(fn(field) {
      case field.label == field.variable {
        True -> field.label <> ":"
        False -> field.label <> ": " <> field.variable
      }
    })
    |> string.join(", ")

  ["pub fn " <> name <> "() -> decode.Decoder(" <> type_name <> ") {", ..uses]
  |> list.append([
    "  decode.success(" <> type_name <> "(" <> arguments <> "))",
    "}",
  ])
  |> string.join("\n")
}

// === TYPES ================================================================

fn type_string(type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).type_
    GleamEnum(names) -> names.type_
    GleamList(item) -> "List(" <> type_string(item) <> ")"
    GleamOption(inner) -> "option.Option(" <> type_string(inner) <> ")"
  }
}

fn type_decoder(type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).decoder
    GleamEnum(names) -> names.decoder <> "()"
    GleamList(item) -> "decode.list(of: " <> type_decoder(item) <> ")"
    GleamOption(inner) -> "decode.optional(" <> type_decoder(inner) <> ")"
  }
}
