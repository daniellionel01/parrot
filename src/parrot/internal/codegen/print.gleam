//// Turns a `model.Module` into gleam source code. The output is formatted
//// with `gleam format` afterwards.

import gleam/int
import gleam/list
import gleam/string
import parrot/internal/codegen/model.{
  type Enum, type Field, type GleamType, type Module, type Param, type Query,
  GleamEnum, GleamList, GleamOption, Scalar,
}
import parrot/internal/codegen/runtime

pub fn module(module: Module) -> String {
  [
    "//// Code generated by parrot. DO NOT EDIT.\n////",
    imports(module),
    string.trim(runtime.code),
    module.enums |> list.map(enum) |> string.join("\n\n"),
    module.queries |> list.map(query) |> string.join("\n\n"),
  ]
  |> string.join("\n\n")
}

fn imports(module: Module) -> String {
  let params = list.flat_map(module.queries, fn(query) { query.params })
  let uses_list =
    list.any(params, fn(param) { param.slice || contains_list(param.type_) })
  let uses_slices = list.any(params, fn(param) { param.slice })

  runtime.imports
  |> append_if(uses_list, "import gleam/list")
  |> append_if(uses_slices, "import gleam/string")
  |> string.join("\n")
}

fn contains_list(type_: GleamType) -> Bool {
  case type_ {
    GleamList(_) -> True
    GleamOption(inner) -> contains_list(inner)
    Scalar(_) | GleamEnum(_) -> False
  }
}

fn append_if(
  lines: List(String),
  condition: Bool,
  line: String,
) -> List(String) {
  case condition {
    True -> list.append(lines, [line])
    False -> lines
  }
}

// === ENUMS ================================================================

fn enum(enum: Enum) -> String {
  let model.Names(type_:, function:, decoder:) = enum.names
  let variants = [enum.first, ..enum.rest]

  ["pub type " <> type_ <> " {", ..list.map(variants, fn(v) { "  " <> v.name })]
  |> list.append([
    "}",
    "",
    "pub fn " <> decoder <> "() -> decode.Decoder(" <> type_ <> ") {",
    "  use variant <- decode.then(decode.string)",
    "  case variant {",
    ..list.map(variants, fn(v) {
      "    \"" <> v.value <> "\" -> decode.success(" <> v.name <> ")"
    })
  ])
  |> list.append([
    "    _ -> decode.failure(" <> enum.first.name <> ", \"" <> type_ <> "\")",
    "  }",
    "}",
    "",
    "pub fn " <> function <> "(val: " <> type_ <> ") -> String {",
    "  case val {",
    ..list.map(variants, fn(v) {
      "    " <> v.name <> " -> \"" <> v.value <> "\""
    })
  ])
  |> list.append(["  }", "}"])
  |> string.join("\n")
}

// === QUERIES ==============================================================

fn query(query: Query) -> String {
  case query.columns {
    [] -> function(query)
    _ ->
      row_type(query) <> "\n\n" <> function(query) <> "\n\n" <> decoder(query)
  }
}

fn row_type(query: Query) -> String {
  let name = query.names.type_
  let fields =
    list.map(query.columns, fn(field) {
      "    " <> field.name <> ": " <> type_string(field.type_) <> ","
    })

  ["pub type " <> name <> " {", "  " <> name <> "(", ..fields]
  |> list.append(["  )", "}"])
  |> string.join("\n")
}

fn function(query: Query) -> String {
  let arguments =
    query.params
    |> list.map(fn(param) {
      let type_ = case param.slice {
        True -> "List(" <> type_string(param.type_) <> ")"
        False -> type_string(param.type_)
      }
      param.name <> " " <> param.name <> ": " <> type_
    })
    |> string.join(", ")

  let slices =
    query.params
    |> list.filter(fn(param) { param.slice })
    |> list.map(fn(param) {
      // An empty list is replaced with `NULL`, same as sqlc does for go,
      // since `in ()` is not valid sql in every database.
      "  let "
      <> slice_variable(param.name)
      <> " = case "
      <> param.name
      <> " {\n    [] -> \"NULL\"\n    _ -> list.map("
      <> param.name
      <> ", fn(_) { \"?\" }) |> string.join(\",\")\n  }"
    })

  let #(returned, return_type) = case query.returns_rows {
    True -> #(
      ["sql", params(query.params), query.names.decoder <> "()"],
      "#(String, List(Param), decode.Decoder(" <> query.names.type_ <> "))",
    )
    False -> #(["sql", params(query.params)], "#(String, List(Param))")
  }

  [
    "pub fn "
      <> query.names.function
      <> "("
      <> arguments
      <> ") -> "
      <> return_type
      <> " {",
    ..slices
  ]
  |> list.append([
    "  let sql = " <> sql(query.sql),
    "  #(" <> string.join(returned, ", ") <> ")",
    "}",
  ])
  |> string.join("\n")
}

fn slice_variable(param: String) -> String {
  param <> "_slice"
}

fn sql(parts: List(model.SqlPart)) -> String {
  parts
  |> list.map(fn(part) {
    case part {
      model.Text(text) ->
        "\"" <> string.replace(text, each: "\"", with: "\\\"") <> "\""
      model.Slice(param) -> slice_variable(param)
    }
  })
  |> string.join(" <> ")
}

fn params(params: List(Param)) -> String {
  case list.any(params, fn(param) { param.slice }) {
    False -> "[" <> string.join(list.map(params, param_value), ", ") <> "]"
    True ->
      "list.flatten(["
      <> params
      |> list.map(fn(param) {
        case param.slice {
          True -> slice_values(param)
          False -> "[" <> param_value(param) <> "]"
        }
      })
      |> string.join(", ")
      <> "])"
  }
}

fn param_value(param: Param) -> String {
  value_to_param(param.name, param.type_)
}

fn slice_values(param: Param) -> String {
  "list.map(" <> param.name <> ", " <> item_to_param(param.type_) <> ")"
}

/// Wraps the gleam value `variable` of type `type_` in a `Param`.
///
fn value_to_param(variable: String, type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).param <> "(" <> variable <> ")"
    GleamEnum(names) ->
      "ParamString(" <> names.function <> "(" <> variable <> "))"
    GleamList(item) ->
      "ParamList(list.map(" <> variable <> ", " <> item_to_param(item) <> "))"
    GleamOption(inner) ->
      "ParamNullable(option.map("
      <> variable
      <> ", fn(v) { "
      <> value_to_param("v", inner)
      <> " }))"
  }
}

/// A function turning a list item into a `Param`.
///
fn item_to_param(item: GleamType) -> String {
  case item {
    Scalar(scalar) -> runtime.scalar(scalar).param
    _ -> "fn(v) { " <> value_to_param("v", item) <> " }"
  }
}

fn decoder(query: Query) -> String {
  let type_name = query.names.type_
  let fields =
    list.index_map(query.columns, fn(field: Field, index) {
      "  use "
      <> field.name
      <> " <- decode.field("
      <> int.to_string(index)
      <> ", "
      <> type_decoder(field.type_)
      <> ")"
    })
  let arguments =
    query.columns
    |> list.map(fn(field) { field.name <> ":" })
    |> string.join(", ")

  [
    "pub fn "
      <> query.names.decoder
      <> "() -> decode.Decoder("
      <> type_name
      <> ") {",
    ..fields
  ]
  |> list.append([
    "  decode.success(" <> type_name <> "(" <> arguments <> "))",
    "}",
  ])
  |> string.join("\n")
}

// === TYPES ================================================================

fn type_string(type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).type_
    GleamEnum(names) -> names.type_
    GleamList(item) -> "List(" <> type_string(item) <> ")"
    GleamOption(inner) -> "option.Option(" <> type_string(inner) <> ")"
  }
}

fn type_decoder(type_: GleamType) -> String {
  case type_ {
    Scalar(scalar) -> runtime.scalar(scalar).decoder
    GleamEnum(names) -> names.decoder <> "()"
    GleamList(item) -> "decode.list(of: " <> type_decoder(item) <> ")"
    GleamOption(inner) -> "decode.optional(" <> type_decoder(inner) <> ")"
  }
}
