//// Turns a `model.Module` into gleam source code. The output is formatted
//// with `gleam format` afterwards.

import gleam/int
import gleam/list
import gleam/string
import parrot/internal/codegen/model.{
  type Enum, type Field, type GleamType, type Module, type Param, type Query,
  GleamBitArray, GleamBool, GleamDate, GleamDynamic, GleamEnum, GleamFloat,
  GleamInt, GleamList, GleamOption, GleamString, GleamTimeOfDay, GleamTimestamp,
}
import parrot/internal/codegen/seed
import parrot/internal/string_extra

pub fn module(module: Module) -> String {
  [
    "//// Code generated by parrot. DO NOT EDIT.\n////",
    imports(module),
    string.trim(seed.code),
    module.enums |> list.map(enum) |> string.join("\n\n"),
    module.queries |> list.map(query) |> string.join("\n\n"),
  ]
  |> string.join("\n\n")
}

fn imports(module: Module) -> String {
  let types =
    list.flat_map(module.queries, fn(query) {
      list.append(
        list.map(query.columns, fn(field) { field.type_ }),
        list.map(query.params, fn(param) { param.type_ }),
      )
    })
  let uses_list =
    list.any(types, fn(type_) {
      case type_ {
        GleamList(_) | GleamOption(GleamList(_)) -> True
        _ -> False
      }
    })
  let uses_slices =
    list.any(module.queries, fn(query) {
      list.any(query.params, fn(param) { param.slice })
    })

  [
    "import gleam/dynamic/decode",
    "import gleam/float",
    "import gleam/option",
    "import gleam/time/calendar.{type Date, type TimeOfDay, Date}",
    "import gleam/time/timestamp.{type Timestamp}",
  ]
  |> append_if(uses_list, "import gleam/list")
  |> append_if(uses_slices, "import gleam/string")
  |> string.join("\n")
}

fn append_if(
  lines: List(String),
  condition: Bool,
  line: String,
) -> List(String) {
  case condition {
    True -> list.append(lines, [line])
    False -> lines
  }
}

// === ENUMS ================================================================

fn enum(enum: Enum) -> String {
  let type_name = string_extra.pascal_case(enum.name)
  let fn_name = string_extra.snake_case(enum.name)
  let values = [enum.first, ..enum.rest]

  let variants =
    list.map(values, fn(value) { "  " <> string_extra.pascal_case(value) })
  let decode_cases =
    list.map(values, fn(value) {
      "    \""
      <> value
      <> "\" -> decode.success("
      <> string_extra.pascal_case(value)
      <> ")"
    })
  let to_string_cases =
    list.map(values, fn(value) {
      "    " <> string_extra.pascal_case(value) <> " -> \"" <> value <> "\""
    })

  ["pub type " <> type_name <> " {", ..variants]
  |> list.append([
    "}",
    "",
    "pub fn " <> fn_name <> "_decoder() {",
    "  use variant <- decode.then(decode.string)",
    "  case variant {",
    ..decode_cases
  ])
  |> list.append([
    "    _ -> decode.failure("
      <> string_extra.pascal_case(enum.first)
      <> ", \""
      <> type_name
      <> "\")",
    "  }",
    "}",
    "",
    "pub fn " <> fn_name <> "_to_string(val: " <> type_name <> ") {",
    "  case val {",
    ..to_string_cases
  ])
  |> list.append(["  }", "}"])
  |> string.join("\n")
}

// === QUERIES ==============================================================

fn query(query: Query) -> String {
  case query.columns {
    [] -> function(query)
    _ ->
      row_type(query) <> "\n\n" <> function(query) <> "\n\n" <> decoder(query)
  }
}

fn row_type(query: Query) -> String {
  let name = string_extra.pascal_case(query.name)
  let fields =
    list.map(query.columns, fn(field) {
      "    " <> field.name <> ": " <> type_string(field.type_) <> ","
    })

  ["pub type " <> name <> " {", "  " <> name <> "(", ..fields]
  |> list.append(["  )", "}"])
  |> string.join("\n")
}

fn function(query: Query) -> String {
  let fn_name = string_extra.snake_case(query.name)
  let arguments =
    query.params
    |> list.map(fn(param) {
      param.name <> " " <> param.name <> ": " <> type_string(param.type_)
    })
    |> string.join(", ")

  let slices =
    query.params
    |> list.filter(fn(param) { param.slice })
    |> list.map(fn(param) {
      // An empty list is replaced with `NULL`, same as sqlc does for go,
      // since `in ()` is not valid sql in every database.
      "  let "
      <> param.name
      <> "_slice = case "
      <> param.name
      <> " {\n    [] -> \"NULL\"\n    _ -> list.map("
      <> param.name
      <> ", fn(_) { \"?\" }) |> string.join(\",\")\n  }"
    })

  let returned = case query.returns_rows {
    True -> [
      "sql",
      params(query.params),
      string_extra.snake_case(query.name) <> "_decoder()",
    ]
    False -> ["sql", params(query.params)]
  }

  ["pub fn " <> fn_name <> "(" <> arguments <> ") {", ..slices]
  |> list.append([
    "  let sql = " <> sql(query.sql),
    "  #(" <> string.join(returned, ", ") <> ")",
    "}",
  ])
  |> string.join("\n")
}

fn sql(parts: List(model.SqlPart)) -> String {
  parts
  |> list.map(fn(part) {
    case part {
      model.Text(text) ->
        "\"" <> string.replace(text, each: "\"", with: "\\\"") <> "\""
      model.Slice(param) -> param <> "_slice"
    }
  })
  |> string.join(" <> ")
}

fn params(params: List(Param)) -> String {
  let any_slice = list.any(params, fn(param) { param.slice })
  let all_slices = list.all(params, fn(param) { param.slice })

  case params, any_slice, all_slices {
    [], _, _ -> "[]"
    _, False, _ ->
      "[" <> string.join(list.map(params, param_value), ", ") <> "]"
    _, True, True ->
      "list.flatten(["
      <> string.join(list.map(params, slice_values), ", ")
      <> "])"
    _, True, False ->
      list.fold(params, "list.new()", fn(acc, param) {
        case param.slice {
          True -> acc <> " |> list.append(" <> slice_values(param) <> ")"
          False -> acc <> " |> list.append([" <> param_value(param) <> "])"
        }
      })
  }
}

fn param_value(param: Param) -> String {
  value_to_param(param.name, param.type_)
}

fn slice_values(param: Param) -> String {
  let item = case param.type_ {
    GleamList(item) -> item
    type_ -> type_
  }
  "list.map(" <> param.name <> ", " <> item_to_param(item) <> ")"
}

/// Wraps the gleam value `variable` of type `type_` in a `Param`.
///
fn value_to_param(variable: String, type_: GleamType) -> String {
  let value = case type_ {
    GleamEnum(name) ->
      string_extra.snake_case(name) <> "_to_string(" <> variable <> ")"
    _ -> variable
  }
  case type_ {
    GleamList(item) ->
      "ParamList(list.map(" <> value <> ", " <> item_to_param(item) <> "))"
    GleamOption(inner) ->
      "ParamNullable(option.map("
      <> value
      <> ", fn(v) { "
      <> value_to_param("v", inner)
      <> " }))"
    _ -> param_constructor(type_) <> "(" <> value <> ")"
  }
}

/// A function turning a list item into a `Param`.
///
fn item_to_param(item: GleamType) -> String {
  case item {
    GleamEnum(_) -> "fn(v) { " <> value_to_param("v", item) <> " }"
    _ -> param_constructor(item)
  }
}

fn decoder(query: Query) -> String {
  let type_name = string_extra.pascal_case(query.name)
  let fields =
    list.index_map(query.columns, fn(field: Field, index) {
      "  use "
      <> field.name
      <> " <- decode.field("
      <> int.to_string(index)
      <> ", "
      <> type_decoder(field.type_)
      <> ")"
    })
  let arguments =
    query.columns
    |> list.map(fn(field) { field.name <> ":" })
    |> string.join(", ")

  [
    "pub fn "
      <> string_extra.snake_case(query.name)
      <> "_decoder() -> decode.Decoder("
      <> type_name
      <> ") {",
    ..fields
  ]
  |> list.append([
    "  decode.success(" <> type_name <> "(" <> arguments <> "))",
    "}",
  ])
  |> string.join("\n")
}

// === TYPES ================================================================

fn type_string(type_: GleamType) -> String {
  case type_ {
    GleamBool -> "Bool"
    GleamFloat -> "Float"
    GleamInt -> "Int"
    GleamString -> "String"
    GleamTimestamp -> "Timestamp"
    GleamTimeOfDay -> "TimeOfDay"
    GleamDate -> "Date"
    GleamBitArray -> "BitArray"
    GleamList(item) -> "List(" <> type_string(item) <> ")"
    GleamOption(inner) -> "option.Option(" <> type_string(inner) <> ")"
    GleamEnum(name) -> string_extra.pascal_case(name)
    GleamDynamic -> "decode.Dynamic"
  }
}

fn param_constructor(type_: GleamType) -> String {
  case type_ {
    GleamInt -> "ParamInt"
    GleamString -> "ParamString"
    GleamFloat -> "ParamFloat"
    GleamBool -> "ParamBool"
    GleamTimestamp -> "ParamTimestamp"
    GleamTimeOfDay -> "ParamTimeOfDay"
    GleamDate -> "ParamDate"
    GleamBitArray -> "ParamBitArray"
    GleamDynamic -> "ParamDynamic"
    GleamEnum(_) -> "ParamString"
    GleamOption(inner) -> "ParamNullable(" <> param_constructor(inner) <> ")"
    GleamList(item) -> "ParamList(" <> param_constructor(item) <> ")"
  }
}

fn type_decoder(type_: GleamType) -> String {
  case type_ {
    GleamInt -> "decode.int"
    GleamString -> "decode.string"
    GleamBool -> "bool_decoder()"
    GleamFloat -> "decode.float"
    GleamTimestamp -> "datetime_decoder()"
    GleamTimeOfDay -> "time_of_day_decoder()"
    GleamDate -> "calendar_date_decoder()"
    GleamBitArray -> "decode.bit_array"
    GleamOption(inner) -> "decode.optional(" <> type_decoder(inner) <> ")"
    GleamList(item) -> "decode.list(of: " <> type_decoder(item) <> ")"
    GleamEnum(name) -> string_extra.snake_case(name) <> "_decoder()"
    GleamDynamic -> "decode.dynamic"
  }
}
