-- schema.sql ------------------------------------------------------------------

create table posts (
  id serial primary key,
  tags text[] not null,
  scores int[],
  matrix int[][]
);

-- queries.sql -----------------------------------------------------------------

-- name: GetPost :one
select * from posts where id = $1;

-- name: PostsWithTag :many
select id from posts where sqlc.arg(tag)::text = any(tags);

-- name: InsertPost :exec
insert into posts (tags, scores) values ($1, $2);

-- sqlc ------------------------------------------------------------------------

query GetPost :one
  params:
    $1 posts.id: serial (not null)
  columns:
    posts.id: serial (not null)
    posts.tags: text[] (not null)
    posts.scores: int4[] (null)
    posts.matrix: int4[] (null)

query PostsWithTag :many
  params:
    $1 tag: text (not null)
  columns:
    posts.id: serial (not null)

query InsertPost :exec
  params:
    $1 posts.tags: text[] (not null)
    $2 posts.scores: pg_catalog.int4[] (null)
  columns: none

-- unknown types ---------------------------------------------------------------



