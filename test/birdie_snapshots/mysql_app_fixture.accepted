-- schema.sql ------------------------------------------------------------------

drop table if exists posts;
drop table if exists users;

create table users (
  id int auto_increment primary key,
  username varchar(255) not null unique,
  created_at timestamp default current_timestamp,
  status enum('like', 'neutral'),
  admin tinyint(1) not null default 1
);

create table posts (
  id int auto_increment primary key,
  created_at timestamp default current_timestamp,
  title varchar(255) not null unique,

  user_id integer,

  foreign key (user_id) references users(id) on delete cascade
);

-- queries.sql -----------------------------------------------------------------

-- name: Simple :one
select 1;

-- name: GetUser :one
SELECT
  *
FROM
  users
WHERE
  id = ?
LIMIT
  1;

-- name: ListUsers :many
SELECT
  *
FROM
  users
ORDER BY
  created_at DESC;

-- name: CreateUser :exec
INSERT INTO
  users (username)
VALUES
  (?);

-- name: UpdateUserUsername :exec
UPDATE users
SET
  username = ?
WHERE
  id = ?;

-- name: DeleteUser :exec
DELETE FROM users
WHERE
  id = ?;

-- name: GetUserByUsername :one
SELECT
  *
FROM
  users
WHERE
  username = ?
LIMIT
  1;


-- name: PostsByUsername :many
select
  id,
  title,
  user_id
from posts
where user_id = (
  select id
  from users
  where username = ?
);

-- name: PostsByAdmins :many
select
  id,
  title,
  user_id
from posts
where user_id in (
  select id
  from users
  where users.role = 'admin'
);

-- sqlc ------------------------------------------------------------------------

table users
  users.id: int (not null)
  users.username: varchar (not null)
  users.created_at: timestamp (null)
  users.status: users_status (null)
  users.admin: tinyint (not null)

table posts
  posts.id: int (not null)
  posts.created_at: timestamp (null)
  posts.title: varchar (not null)
  posts.user_id: int (null)

enum users_status
  like | neutral

query Simple :one
  params: none
  columns:
    <unnamed>: int (not null)

query GetUser :one
  params:
    $1 users.id: int (not null)
  columns:
    users.id: int (not null)
    users.username: varchar (not null)
    users.created_at: timestamp (null)
    users.status: users_status (null)
    users.admin: tinyint (not null)

query ListUsers :many
  params: none
  columns:
    users.id: int (not null)
    users.username: varchar (not null)
    users.created_at: timestamp (null)
    users.status: users_status (null)
    users.admin: tinyint (not null)

query CreateUser :exec
  params:
    $1 users.username: varchar (not null)
  columns: none

query UpdateUserUsername :exec
  params:
    $1 users.username: varchar (not null)
    $2 users.id: int (not null)
  columns: none

query DeleteUser :exec
  params:
    $1 users.id: int (not null)
  columns: none

query GetUserByUsername :one
  params:
    $1 users.username: varchar (not null)
  columns:
    users.id: int (not null)
    users.username: varchar (not null)
    users.created_at: timestamp (null)
    users.status: users_status (null)
    users.admin: tinyint (not null)

query PostsByUsername :many
  params:
    $1 users.username: varchar (not null)
  columns:
    posts.id: int (not null)
    posts.title: varchar (not null)
    posts.user_id: int (null)

query PostsByAdmins :many
  params: none
  columns:
    posts.id: int (not null)
    posts.title: varchar (not null)
    posts.user_id: int (null)

