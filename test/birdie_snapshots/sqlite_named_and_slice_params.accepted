---
version: 2.0.2
title: sqlite named and slice params
---
-- schema.sql ------------------------------------------------------------------

create table things (
  id integer primary key autoincrement,
  name text not null
);

-- queries.sql -----------------------------------------------------------------

-- name: ThingsByIds :many
select id, name from things where id in (sqlc.slice('ids'));

-- name: RenameThing :exec
update things set name = sqlc.arg(new_name) where id = sqlc.arg(id);

-- name: ThingsByName :many
select id from things where name = @name;

-- sqlc ------------------------------------------------------------------------

query ThingsByIds :many
  params:
    $1 things.ids: integer (not null, slice)
  columns:
    things.id: integer (not null)
    things.name: text (not null)

query RenameThing :exec
  params:
    $1 things.new_name: text (not null)
    $2 things.id: integer (not null)
  columns: none

query ThingsByName :many
  params:
    $1 things.name: text (not null)
  columns:
    things.id: integer (not null)

-- unknown types ---------------------------------------------------------------



-- sql.gleam -------------------------------------------------------------------

//// Code generated by parrot. DO NOT EDIT.
////

import gleam/dynamic/decode
import gleam/float
import gleam/list
import gleam/option
import gleam/string
import gleam/time/calendar.{type Date, type TimeOfDay, Date}
import gleam/time/timestamp.{type Timestamp}

// <runtime code>

pub type ThingsByIds {
  ThingsByIds(id: Int, name: String)
}

pub fn things_by_ids(ids ids: List(Int)) {
  let ids_slice = case ids {
    [] -> "NULL"
    _ -> list.map(ids, fn(_) { "?" }) |> string.join(",")
  }
  let sql = "select id, name from things where id in (" <> ids_slice <> ")"
  #(sql, list.flatten([list.map(ids, ParamInt)]), things_by_ids_decoder())
}

pub fn things_by_ids_decoder() -> decode.Decoder(ThingsByIds) {
  use id <- decode.field(0, decode.int)
  use name <- decode.field(1, decode.string)
  decode.success(ThingsByIds(id:, name:))
}

pub fn rename_thing(new_name new_name: String, id id: Int) {
  let sql = "update things set name = ?1 where id = ?2"
  #(sql, [ParamString(new_name), ParamInt(id)])
}

pub type ThingsByName {
  ThingsByName(id: Int)
}

pub fn things_by_name(name name: String) {
  let sql = "select id from things where name = ?1"
  #(sql, [ParamString(name)], things_by_name_decoder())
}

pub fn things_by_name_decoder() -> decode.Decoder(ThingsByName) {
  use id <- decode.field(0, decode.int)
  decode.success(ThingsByName(id:))
}
