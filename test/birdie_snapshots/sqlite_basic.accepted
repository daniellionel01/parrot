---
version: 2.0.2
title: sqlite basic
---
-- schema.sql ------------------------------------------------------------------

create table users (
  id integer primary key autoincrement,
  username text not null unique
);

-- queries.sql -----------------------------------------------------------------

-- name: CountUsers :one
select count(*) from users;

-- name: CreateUser :exec
insert into users (username) values (?);

-- name: ListUsers :many
select * from users;

-- sqlc ------------------------------------------------------------------------

query CountUsers :one
  params: none
  columns:
    count: integer (not null)

query CreateUser :exec
  params:
    $1 users.username: text (not null)
  columns: none

query ListUsers :many
  params: none
  columns:
    users.id: integer (not null)
    users.username: text (not null)

-- unknown types ---------------------------------------------------------------



