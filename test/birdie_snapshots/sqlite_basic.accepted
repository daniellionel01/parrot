pub type CountUsers {
  CountUsers(count: Int)
}

pub fn count_users() {
  let sql = "select count(*) from users"
  #(sql, [], count_users_decoder())
}

pub fn count_users_decoder() -> decode.Decoder(CountUsers) {
  use count <- decode.field(0, decode.int)
  decode.success(CountUsers(count:))
}

pub fn create_user(username username: String) {
  let sql = "insert into users (username) values (?)"
  #(sql, [ParamString(username)])
}

pub type ListUsers {
  ListUsers(id: Int, username: String)
}

pub fn list_users() {
  let sql = "select id, username from users"
  #(sql, [], list_users_decoder())
}

pub fn list_users_decoder() -> decode.Decoder(ListUsers) {
  use id <- decode.field(0, decode.int)
  use username <- decode.field(1, decode.string)
  decode.success(ListUsers(id:, username:))
