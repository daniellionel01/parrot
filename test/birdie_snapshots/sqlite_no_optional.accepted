-- schema.sql ------------------------------------------------------------------

create table users (
  id integer primary key autoincrement,
  username text not null unique,
  created_at text not null default current_timestamp,
  balance real not null default 0.0
);

-- queries.sql -----------------------------------------------------------------

-- name: Simple :one
select 1;

-- name: CountUsers :many
SELECT
  count(*)
FROM
  users;

-- name: CreateUser :exec
INSERT INTO
  users (username)
VALUES
  (?);

-- sqlc ------------------------------------------------------------------------

query Simple :one
  params: none
  columns:
    <unnamed>: int (not null)

query CountUsers :many
  params: none
  columns:
    count: integer (not null)

query CreateUser :exec
  params:
    $1 users.username: text (not null)
  columns: none

-- unknown types ---------------------------------------------------------------



