---
version: 2.0.2
title: postgres query on a table that does not exist
---
-- schema.sql ------------------------------------------------------------------

create table users (id serial primary key);

-- queries.sql -----------------------------------------------------------------

-- name: GetPost :one
select * from posts where id = $1;

-- error -----------------------------------------------------------------------

could not call `sqlc generate`:
# package 
queries.sql:1:1: relation "posts" does not exist
