---
version: 2.0.2
title: postgres enums
---
-- schema.sql ------------------------------------------------------------------

create type user_role as enum ('admin', 'regular_user', 'guest');

create table users (
  id serial primary key,
  username text not null,
  role user_role not null,
  previous_role user_role,
  past_roles user_role[] not null
);

-- queries.sql -----------------------------------------------------------------

-- name: GetPastRoles :one
select past_roles from users where id = $1;

-- name: SetPastRoles :exec
update users set past_roles = $1 where id = $2;

-- name: GetUserRoles :many
select role, previous_role from users;

-- name: SetRole :exec
update users set role = $1 where id = $2;

-- name: UsersWithRole :many
select id, username from users where role = $1;

-- sqlc ------------------------------------------------------------------------

enum user_role
  admin | regular_user | guest

query GetPastRoles :one
  params:
    $1 users.id: serial (not null)
  columns:
    users.past_roles: user_role[] (not null)

query SetPastRoles :exec
  params:
    $1 users.past_roles: user_role[] (not null)
    $2 users.id: serial (not null)
  columns: none

query GetUserRoles :many
  params: none
  columns:
    users.role: user_role (not null)
    users.previous_role: user_role (null)

query SetRole :exec
  params:
    $1 users.role: user_role (not null)
    $2 users.id: serial (not null)
  columns: none

query UsersWithRole :many
  params:
    $1 users.role: user_role (not null)
  columns:
    users.id: serial (not null)
    users.username: text (not null)

-- unknown types ---------------------------------------------------------------



