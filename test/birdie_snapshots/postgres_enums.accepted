-- schema.sql ------------------------------------------------------------------

create type user_role as enum ('admin', 'regular_user', 'guest');

create table users (
  id serial primary key,
  username text not null,
  role user_role not null,
  previous_role user_role
);

-- queries.sql -----------------------------------------------------------------

-- name: GetUserRoles :many
select role, previous_role from users;

-- name: SetRole :exec
update users set role = $1 where id = $2;

-- name: UsersWithRole :many
select id, username from users where role = $1;

-- sqlc ------------------------------------------------------------------------

table users
  users.id: serial (not null)
  users.username: text (not null)
  users.role: user_role (not null)
  users.previous_role: user_role (null)

enum user_role
  admin | regular_user | guest

query GetUserRoles :many
  params: none
  columns:
    users.role: user_role (not null)
    users.previous_role: user_role (null)

query SetRole :exec
  params:
    $1 users.role: user_role (not null)
    $2 users.id: serial (not null)
  columns: none

query UsersWithRole :many
  params:
    $1 users.role: user_role (not null)
  columns:
    users.id: serial (not null)
    users.username: text (not null)

