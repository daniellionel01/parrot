---
version: 2.0.2
title: mysql column types
---
-- schema.sql ------------------------------------------------------------------

create table accounts (
  id int unsigned not null auto_increment primary key,
  email varchar(255) not null,
  status enum('active', 'suspended') not null,
  is_verified tinyint(1) not null,
  balance decimal(10, 2),
  created_at datetime not null,
  last_login timestamp null,
  birthday date
);

-- queries.sql -----------------------------------------------------------------

-- name: GetAccount :one
select * from accounts where id = ?;

-- name: CreateAccount :exec
insert into accounts (email, status, is_verified, created_at)
values (?, ?, ?, ?);

-- name: AccountsByIds :many
select id, email from accounts where id in (sqlc.slice('ids'));

-- sqlc ------------------------------------------------------------------------

table accounts
  accounts.id: int (not null, unsigned)
  accounts.email: varchar (not null)
  accounts.status: accounts_status (not null)
  accounts.is_verified: tinyint (not null)
  accounts.balance: decimal (null)
  accounts.created_at: datetime (not null)
  accounts.last_login: timestamp (null)
  accounts.birthday: date (null)

enum accounts_status
  active | suspended

query GetAccount :one
  params:
    $1 accounts.id: int (not null, unsigned)
  columns:
    accounts.id: int (not null, unsigned)
    accounts.email: varchar (not null)
    accounts.status: accounts_status (not null)
    accounts.is_verified: tinyint (not null)
    accounts.balance: decimal (null)
    accounts.created_at: datetime (not null)
    accounts.last_login: timestamp (null)
    accounts.birthday: date (null)

query CreateAccount :exec
  params:
    $1 accounts.email: varchar (not null)
    $2 accounts.status: accounts_status (not null)
    $3 accounts.is_verified: tinyint (not null)
    $4 accounts.created_at: datetime (not null)
  columns: none

query AccountsByIds :many
  params:
    $1 accounts.ids: int (not null, unsigned, slice)
  columns:
    accounts.id: int (not null, unsigned)
    accounts.email: varchar (not null)

-- sql.gleam -------------------------------------------------------------------

