---
version: 2.0.2
title: postgres column types including unsupported ones
---
-- schema.sql ------------------------------------------------------------------

create table events (
  id bigserial primary key,
  happened_at timestamp not null,
  happened_at_tz timestamptz,
  day date not null,
  starts time,
  duration interval,
  payload jsonb not null,
  external_id uuid not null,
  ip inet,
  amount numeric(10, 2),
  ratio double precision not null,
  is_public boolean not null,
  raw bytea
);

-- queries.sql -----------------------------------------------------------------

-- name: GetEvent :one
select * from events where id = $1;

-- name: InsertEvent :exec
insert into events (happened_at, day, payload, external_id, ratio, is_public)
values ($1, $2, $3, $4, $5, $6);

-- sqlc ------------------------------------------------------------------------

table events
  events.id: bigserial (not null)
  events.happened_at: timestamp (not null)
  events.happened_at_tz: timestamptz (null)
  events.day: date (not null)
  events.starts: time (null)
  events.duration: interval (null)
  events.payload: jsonb (not null)
  events.external_id: uuid (not null)
  events.ip: inet (null)
  events.amount: numeric (null)
  events.ratio: float8 (not null)
  events.is_public: bool (not null)
  events.raw: bytea (null)

query GetEvent :one
  params:
    $1 events.id: bigserial (not null)
  columns:
    events.id: bigserial (not null)
    events.happened_at: timestamp (not null)
    events.happened_at_tz: timestamptz (null)
    events.day: date (not null)
    events.starts: time (null)
    events.duration: interval (null)
    events.payload: jsonb (not null)
    events.external_id: uuid (not null)
    events.ip: inet (null)
    events.amount: numeric (null)
    events.ratio: float8 (not null)
    events.is_public: bool (not null)
    events.raw: bytea (null)

query InsertEvent :exec
  params:
    $1 events.happened_at: pg_catalog.timestamp (not null)
    $2 events.day: date (not null)
    $3 events.payload: jsonb (not null)
    $4 events.external_id: uuid (not null)
    $5 events.ratio: pg_catalog.float8 (not null)
    $6 events.is_public: pg_catalog.bool (not null)
  columns: none

