---
version: 2.0.2
title: sqlite app
---
-- schema.sql ------------------------------------------------------------------

create table users (
  id integer primary key autoincrement,
  username text not null unique,
  created_at text default current_timestamp,
  balance real not null default 0.0,
  last_known_location decimal(9, 6),
  role text,
  avatar blob,

  type text
);

create table posts (
  id integer primary key autoincrement,
  created_at text default current_timestamp,
  title text not null unique,

  user_id integer not null,

  foreign key (user_id) references users(id) on delete cascade
);

-- queries.sql -----------------------------------------------------------------

-- name: Simple :one
select 1;

-- name: CountUsers :many
SELECT
  count(*)
FROM
  users;

-- name: CreateUser :exec
INSERT INTO
  users (username)
VALUES
  (?);

-- name: CreateUserWithRole :exec
INSERT INTO
  users (username, role)
VALUES
  (?, ?);

-- name: UpdateUserUsername :exec
UPDATE users
SET
  username = ?
WHERE
  id = ?;

-- name: UpdateUserType :exec
UPDATE users
SET
  type = ?
WHERE
  id = ?;

-- name: GetUserByUsername :one
SELECT
  *
FROM
  users
WHERE
  username = ?
LIMIT
  1;

-- name: PostsByUsername :many
select
  id,
  title,
  user_id
from posts
where user_id = (
  select id
  from users
  where username = ?
);

-- name: PostsByAdmins :many
select
  id,
  title,
  user_id
from posts
where user_id in (
  select id
  from users
  where users.role = 'admin'
);

-- name: PostsByIds :many
select id
from posts
where user_id in (sqlc.slice('ids'));

-- name: PostsByIdsAndTitle :many
select id
from posts
where user_id in (sqlc.slice('ids')) and title = ?;

-- name: PostsByIdsAndStatus :many
select id
from posts
where title = ? and user_id in (sqlc.slice('ids'));

-- name: MultipleSlices :many
select id
from posts
where title in (sqlc.slice('titles')) and user_id in (sqlc.slice('ids'));

-- name: MultipleSlicesAndArgument :many
select id
from posts
where user_id = ? and title in (sqlc.slice('titles')) and user_id in (sqlc.slice('ids'));

-- sqlc ------------------------------------------------------------------------

query Simple :one
  params: none
  columns:
    <unnamed>: int (not null)

query CountUsers :many
  params: none
  columns:
    count: integer (not null)

query CreateUser :exec
  params:
    $1 users.username: text (not null)
  columns: none

query CreateUserWithRole :exec
  params:
    $1 users.username: text (not null)
    $2 users.role: text (null)
  columns: none

query UpdateUserUsername :exec
  params:
    $1 users.username: text (not null)
    $2 users.id: integer (not null)
  columns: none

query UpdateUserType :exec
  params:
    $1 users.type: text (null)
    $2 users.id: integer (not null)
  columns: none

query GetUserByUsername :one
  params:
    $1 users.username: text (not null)
  columns:
    users.id: integer (not null)
    users.username: text (not null)
    users.created_at: text (null)
    users.balance: real (not null)
    users.last_known_location: decimal(9,6) (null)
    users.role: text (null)
    users.avatar: blob (null)
    users.type: text (null)

query PostsByUsername :many
  params:
    $1 users.username: text (not null)
  columns:
    posts.id: integer (not null)
    posts.title: text (not null)
    posts.user_id: integer (not null)

query PostsByAdmins :many
  params: none
  columns:
    posts.id: integer (not null)
    posts.title: text (not null)
    posts.user_id: integer (not null)

query PostsByIds :many
  params:
    $1 posts.ids: integer (not null, slice)
  columns:
    posts.id: integer (not null)

query PostsByIdsAndTitle :many
  params:
    $2 posts.ids: integer (not null, slice)
    $1 posts.title: text (not null)
  columns:
    posts.id: integer (not null)

query PostsByIdsAndStatus :many
  params:
    $1 posts.title: text (not null)
    $2 posts.ids: integer (not null, slice)
  columns:
    posts.id: integer (not null)

query MultipleSlices :many
  params:
    $1 posts.titles: text (not null, slice)
    $2 posts.ids: integer (not null, slice)
  columns:
    posts.id: integer (not null)

query MultipleSlicesAndArgument :many
  params:
    $1 posts.user_id: integer (not null)
    $2 posts.titles: text (not null, slice)
    $3 posts.ids: integer (not null, slice)
  columns:
    posts.id: integer (not null)

-- unknown types ---------------------------------------------------------------



