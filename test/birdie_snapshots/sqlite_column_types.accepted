// <runtime code>

pub type GetThing {
  GetThing(
    id: Int,
    name: String,
    nickname: option.Option(String),
    score: Float,
    data: option.Option(BitArray),
    active: Bool,
    born: option.Option(Date),
    created_at: Timestamp,
    price: option.Option(Float),
  )
}

pub fn get_thing(
  id id: Int,
) -> #(String, List(Param), decode.Decoder(GetThing)) {
  let sql =
    "select id, name, nickname, score, data, active, born, created_at, price from things where id = ?"
  #(sql, [ParamInt(id)], get_thing_decoder())
}

pub fn get_thing_decoder() -> decode.Decoder(GetThing) {
  use id <- decode.field(0, decode.int)
  use name <- decode.field(1, decode.string)
  use nickname <- decode.field(2, decode.optional(decode.string))
  use score <- decode.field(3, decode.float)
  use data <- decode.field(4, decode.optional(decode.bit_array))
  use active <- decode.field(5, bool_decoder())
  use born <- decode.field(6, decode.optional(calendar_date_decoder()))
  use created_at <- decode.field(7, datetime_decoder())
  use price <- decode.field(8, decode.optional(decode.float))
  decode.success(GetThing(
    id:,
    name:,
    nickname:,
    score:,
    data:,
    active:,
    born:,
    created_at:,
    price:,
  ))
}

pub fn insert_thing(
  name name: String,
  nickname nickname: option.Option(String),
  score score: Float,
  data data: option.Option(BitArray),
  active active: Bool,
  born born: option.Option(Date),
  created_at created_at: Timestamp,
  price price: option.Option(Float),
) -> #(String, List(Param)) {
  let sql =
    "insert into things (name, nickname, score, data, active, born, created_at, price)
values (?, ?, ?, ?, ?, ?, ?, ?)"
  #(sql, [
    ParamString(name),
    ParamNullable(option.map(nickname, fn(v) { ParamString(v) })),
    ParamFloat(score),
    ParamNullable(option.map(data, fn(v) { ParamBitArray(v) })),
    ParamBool(active),
    ParamNullable(option.map(born, fn(v) { ParamDate(v) })),
    ParamTimestamp(created_at),
    ParamNullable(option.map(price, fn(v) { ParamFloat(v) })),
  ])
}
