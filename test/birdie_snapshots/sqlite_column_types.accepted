---
version: 2.0.2
title: sqlite column types
---
-- schema.sql ------------------------------------------------------------------

create table things (
  id integer primary key autoincrement,
  name text not null,
  nickname text,
  score real not null,
  data blob,
  active boolean not null,
  born date,
  created_at datetime not null,
  price numeric
);

-- queries.sql -----------------------------------------------------------------

-- name: GetThing :one
select * from things where id = ?;

-- name: InsertThing :exec
insert into things (name, nickname, score, data, active, born, created_at, price)
values (?, ?, ?, ?, ?, ?, ?, ?);

-- sqlc ------------------------------------------------------------------------

query GetThing :one
  params:
    $1 things.id: integer (not null)
  columns:
    things.id: integer (not null)
    things.name: text (not null)
    things.nickname: text (null)
    things.score: real (not null)
    things.data: blob (null)
    things.active: boolean (not null)
    things.born: date (null)
    things.created_at: datetime (not null)
    things.price: numeric (null)

query InsertThing :exec
  params:
    $1 things.name: text (not null)
    $2 things.nickname: text (null)
    $3 things.score: real (not null)
    $4 things.data: blob (null)
    $5 things.active: boolean (not null)
    $6 things.born: date (null)
    $7 things.created_at: datetime (not null)
    $8 things.price: numeric (null)
  columns: none

-- unknown types ---------------------------------------------------------------



