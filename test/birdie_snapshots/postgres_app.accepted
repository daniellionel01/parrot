  columns:
    users.id: serial (not null)
    users.email: citext (not null)
    users.username: varchar (not null)
    users.created_at: timestamp (null)
    users.date_of_birth: date (null)
    users.profile: jsonb (null)
    users.extra_info: json (null)
    users.favorite_numbers: int4[] (null)
    users.role: user_role (null)
