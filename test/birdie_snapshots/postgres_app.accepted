query PostsByUsername :many
  params:
    $1 users.username: pg_catalog.varchar (not null)
  columns:
    posts.id: serial (not null)
    posts.title: varchar (not null)
    posts.user_id: int4 (not null)

query PostsByAdmins :many
  params: none
